# 影随 ShadowMate 运行配置
# 复制为 .env 后按需修改。所有项都有默认值，不配置也能直接运行。

# 服务端口
PORT=5173

# 语音服务提供方：mock | azure
# mock  = 识别走浏览器本地 Whisper（真实识别，无需凭据），发音评测走本地模拟
# azure = 识别与发音评测都走 Azure AI 语音服务（质量最好，需填写下方三项）
SPEECH_PROVIDER=mock

# 仅在 SPEECH_PROVIDER=azure 时需要
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# 识别与评测的目标语言
AZURE_SPEECH_LANGUAGE=en-US

# 浏览器本地识别模型（SPEECH_PROVIDER=mock 时生效）
# 模型文件由服务端代理下载并落盘缓存（data/models/），浏览器只访问本机地址。
# 首次使用需服务端能联网下载，之后可离线复用。
# tiny 版约 70MB，速度快；对带口音或嘈杂的真实录音，可换成 Xenova/whisper-base.en 提升准确率（约 145MB）
WHISPER_MODEL=Xenova/whisper-tiny.en
# 服务端下载模型的上游地址。国内默认走 hf-mirror；海外可改回 https://huggingface.co
WHISPER_MODEL_HOST=https://hf-mirror.com
# 编码器精度：fp32 更准（约 31MB），q8 更小更快（约 10MB）
WHISPER_ENCODER_DTYPE=fp32

# 上传限制（与 PRD 表 5 一致）
MAX_UPLOAD_MB=50
MIN_AUDIO_SECONDS=30
MAX_AUDIO_SECONDS=600